# Docker Compose 环境变量示例
# 复制为 .env 并填写真实值

# 必填：管理员令牌（生产环境必须修改）
GAOKAO_AGENT_ADMIN_TOKEN=change-this-to-a-strong-token
# 生产环境必须修改；开发环境可使用示例默认值
GAOKAO_AGENT_SESSION_SECRET=change-this-to-a-random-session-secret

# 运行环境（production 时强制要求非默认 admin token）
GAOKAO_AGENT_ENVIRONMENT=development
GAOKAO_AGENT_RELEASE_VERSION=dev

# 端口映射
API_PORT=8000
WEB_PORT=3000

# CORS 允许的前端来源
GAOKAO_AGENT_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Next.js 客户端可访问的 API 地址（浏览器访问）
NEXT_PUBLIC_GAOKAO_AGENT_API_URL=http://localhost:8000

# LLM 配置（可选，留空则禁用 LLM 能力）
GAOKAO_AGENT_LLM_PROVIDER=
GAOKAO_AGENT_LLM_BASE_URL=
GAOKAO_AGENT_LLM_API_KEY=
GAOKAO_AGENT_LLM_MODEL=
GAOKAO_AGENT_LLM_TIMEOUT_SECONDS=30
GAOKAO_AGENT_LLM_MAX_OUTPUT_TOKENS=800
GAOKAO_AGENT_LLM_MAX_RETRIES=1

# 请求预算（单进程默认值；多 worker 需换成共享限流/预算存储）
GAOKAO_AGENT_CHAT_MAX_MESSAGE_CHARS=4000
GAOKAO_AGENT_MODEL_MAX_CONCURRENCY=4
GAOKAO_AGENT_CHAT_REQUEST_TIMEOUT_SECONDS=30
GAOKAO_AGENT_CHAT_RATE_LIMIT_REQUESTS=20
GAOKAO_AGENT_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
GAOKAO_AGENT_CHAT_DAILY_REQUEST_BUDGET=1000

# 智能分析模式：off / gated / on
GAOKAO_AGENT_SMART_ANALYSIS_MODE=off

# 微信公众号配置（可选）
GAOKAO_AGENT_WECHAT_OFFICIAL_ACCOUNT_TOKEN=
GAOKAO_AGENT_WECHAT_OFFICIAL_ACCOUNT_APP_ID=
GAOKAO_AGENT_WECHAT_OFFICIAL_ACCOUNT_ENCODING_AES_KEY=
