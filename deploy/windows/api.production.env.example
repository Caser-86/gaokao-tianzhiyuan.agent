GAOKAO_AGENT_ENVIRONMENT=production
GAOKAO_AGENT_RELEASE_VERSION=replace-with-release-version
GAOKAO_AGENT_ADMIN_TOKEN=replace-with-a-strong-admin-token
GAOKAO_AGENT_SESSION_SECRET=replace-with-a-long-random-session-secret
GAOKAO_AGENT_DATABASE_URL=sqlite:///D:/gaokao-agent/data/gaokao-agent.db

GAOKAO_AGENT_LLM_PROVIDER=openai_compatible
GAOKAO_AGENT_LLM_BASE_URL=https://your-relay.example
GAOKAO_AGENT_LLM_API_KEY=replace-with-your-relay-api-key
GAOKAO_AGENT_LLM_MODEL=gpt-4o-mini
GAOKAO_AGENT_LLM_TIMEOUT_SECONDS=30
GAOKAO_AGENT_LLM_MAX_OUTPUT_TOKENS=800
GAOKAO_AGENT_LLM_MAX_RETRIES=1
GAOKAO_AGENT_CHAT_MAX_MESSAGE_CHARS=4000
GAOKAO_AGENT_MODEL_MAX_CONCURRENCY=4
GAOKAO_AGENT_CHAT_REQUEST_TIMEOUT_SECONDS=30
GAOKAO_AGENT_CHAT_RATE_LIMIT_REQUESTS=20
GAOKAO_AGENT_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
GAOKAO_AGENT_CHAT_DAILY_REQUEST_BUDGET=1000
GAOKAO_AGENT_MEDIA_ANALYSIS_PROVIDER=
GAOKAO_AGENT_MEDIA_ANALYSIS_BASE_URL=
GAOKAO_AGENT_MEDIA_ANALYSIS_API_KEY=
GAOKAO_AGENT_MEDIA_ANALYSIS_MODEL=
GAOKAO_AGENT_MEDIA_ANALYSIS_TIMEOUT_SECONDS=30
GAOKAO_AGENT_SMART_ANALYSIS_MODE=off
GAOKAO_AGENT_WECHAT_OFFICIAL_ACCOUNT_TOKEN=replace-with-your-wechat-token
GAOKAO_AGENT_WECHAT_OFFICIAL_ACCOUNT_APP_ID=wx-replace-with-your-app-id
GAOKAO_AGENT_WECHAT_OFFICIAL_ACCOUNT_ENCODING_AES_KEY=replace-with-43-char-encoding-aes-key
GAOKAO_AGENT_WECHAT_SIGNATURE_TTL_SECONDS=300
GAOKAO_AGENT_WECHAT_MAX_BODY_BYTES=262144
GAOKAO_AGENT_CHAT_SESSION_RETENTION_DAYS=30
GAOKAO_AGENT_MEDIA_ANALYSIS_RETENTION_DAYS=30
GAOKAO_AGENT_AGENT_TRACE_RETENTION_DAYS=7

GAOKAO_AGENT_ZHANGXUEFENG_SKILL_PATH=D:/gaokao-agent/vendor/zhangxuefeng-skill/SKILL.md
